# Leave unset to use the bundled SQLite database at backend/gus_dedektiv.db
# DATABASE_URL=postgresql+psycopg://gus:gus@localhost:5432/gus_dedektiv

# ml | mock. ml is the delivered model; it falls back to the rule engine on its
# own if the artefacts or lightgbm are missing, and every response says which.
SCORING_ENGINE=ml

# Comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# One shared sign-in in front of the whole site. Both must be set or the site
# stays open, which is the right default on a laptop and the wrong one on a
# public address. Everyone let in is the same viewer; who signed a decision is
# still decided by API_KEYS below.
# Pick your own; neither has a default and neither belongs in this file.
# SITE_USER=
# SITE_PASSWORD=  # long and random: python -c "import secrets; print(secrets.token_urlsafe(18))"

# Signs the session cookie. Unset, one is made at startup and every restart
# signs everybody out. Set it in a deployment.
# SESSION_SECRET=

# Send the cookie only over HTTPS. Leave false on a laptop over plain http;
# true anywhere real.
# SESSION_COOKIE_SECURE=false

# How long a sign-in lasts, and how many wrong passwords a minute the service
# tolerates from everyone together before it starts refusing. A correct
# password is never refused, so this cannot lock anybody out.
# SESSION_HOURS=12
# LOGIN_ATTEMPTS_PER_MINUTE=20

# Ceilings on the endpoints that cost something to run, per minute. A
# deployment whose sign-in is published has no trusted callers: everyone
# through the door is a stranger. Rescoring is the expensive one - the whole
# population through the model, seconds a call - and the others are capped
# because a decision that costs nothing still appends to the audit chain.
# SCORING_RUNS_PER_MINUTE=4
# PILOT_RUNS_PER_MINUTE=20
# REVIEWS_PER_MINUTE=40

# Writing endpoints (review, scoring run, policy, pilot, assistant) are OPEN
# until a key is set here, so the prototype runs with no setup. Set one and
# they start demanding an X-API-Key header; reading stays open either way.
#
# With key:user pairs the auditor recorded against a decision is the key's
# owner, not the name the request body asks for. Every entry must be key:user;
# a malformed one stops the API at startup instead of leaving the gate open.
# The interface asks for the key once the gate is up.
# API_KEYS=change-me-aydin:aydin.m,change-me-kaya:kaya.s
#
# Or a single key, if one caller is enough:
# API_KEY=change-me
# API_KEY_USER=api

# Reseed the database on boot when it is empty
AUTO_SEED=true

# In-app assistant. Get a key at https://aistudio.google.com/apikey
# Keys issued since 2026 start with `AQ.`; the older `AIzaSy...` form is
# rejected from September 2026. Both are sent as the x-goog-api-key header.
# Leave it empty and the assistant panel stays hidden.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Questions per caller per minute; every one is a paid call on the key above.
# ASSISTANT_REQUESTS_PER_MINUTE=12
