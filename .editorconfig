# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
# Markdown'da satır sonu iki boşluk anlamlıdır.
trim_trailing_whitespace = false

[*.{bat,ps1}]
end_of_line = crlf

[*.{csv,parquet}]
insert_final_newline = false
trim_trailing_whitespace = false

[ml/models/*.txt]
insert_final_newline = false
trim_trailing_whitespace = false

[backend/models/*.txt]
insert_final_newline = false
trim_trailing_whitespace = false
